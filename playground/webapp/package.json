{
  "name": "secret-playground",
  "version": "0.1.0",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "typings": "./dist/index.d.ts",
  "scripts": {
    "lint": "eslint --ext .ts .",
    "tsc" : "rm -rf out-tsc && tsc",
    "dist": "vite build",
    "build": "vite dev --clearScreen false",
    "start:ui": "vite dev --port $UI_PORT --clearScreen false",

    "start": "UI_PORT=$(port) HC_APP_PORT=$(port) HC_ADMIN_PORT=$(port) HAPP_BUILD_MODE='Debug' concurrently \"npm run start:happ:mem\" \"sleep 5 && npm run start:ui\"",
    "start:happ:mem": "RUST_LOG=warn WASM_LOG=warn echo \"pass\" | hc s --piped -f=$HC_ADMIN_PORT generate ../../artifacts/secret.happ --run=$HC_APP_PORT -a hSecret network mem",
    "clean:hc": "rm -rf .hc*"
  },
  "devDependencies": {
    "vite": "=4.5.2",
    "vite-plugin-checker": "=0.5.3",
    "vite-plugin-dts": "4.5.3",
    "vite-plugin-top-level-await": "1.5.0",
    "bestzip": "^2.2.0",
    "concurrently": "^5.3.0",
    "deepmerge": "^4.2.2",
    "exits": "^2.0.1",
    "new-port-cli": "^1.0.0",
    "path-exists-cli": "^2.0.0",
    "run-singleton-cli": "^0.0.5"
  },
  "dependencies": {
    "@ddd-qc/agent-directory": "6.12.1",
    "@ddd-qc/profiles-dvm": "=0.32.8",
    "@ddd-qc/we-utils": "=0.32.8",
    "@ddd-qc/delivery": "file:../../webcomponents"
  }
}
